# ── 必須 ──
# ログインパスワード（長く推測困難なもの）
APP_PASSWORD=
# セッション署名鍵（32文字以上のランダム文字列。例: openssl rand -hex 32）
SESSION_SECRET=

# ── データベース ──
# 未設定: ローカル組込み Postgres（PGlite, ./.data/pglite）
# 本番: Supabase 等の Postgres 接続文字列（Transaction pooler 推奨）
DATABASE_URL=
# PGLITE_DIR=./.data/pglite

# ── 画像認識（任意・従量課金・要承認） ──
ANTHROPIC_API_KEY=
# IDENTIFY_MODEL=claude-opus-5-5
# 1日あたりの画像認識上限（費用暴走防止）
IDENTIFY_DAILY_LIMIT=100
